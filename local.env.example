# Settings for this machine. Copy to local.env and edit.

# server: runs the models (the GPU machine).
# client: reaches a server through an SSH tunnel.
ROLE=server

# Server only. 1 uses the NVIDIA GPU; 0 runs on CPU.
USE_GPU=1

# Client only. SSH destination of the server: user@host, or a Host alias from
# ~/.ssh/config. Connect to it once by hand first, so its host key is known.
SSH_HOST=

# Client only. 1 lets the tunnel use your SSH agent, for keys that have a
# passphrase. Requires the agent to be running when the tunnel starts.
TUNNEL_USE_AGENT=0

# The only folder the OpenCode container can read and write.
PROJECTS_DIR=$HOME/Projects

# Optional. A markdown file with your own coding rules, for example
# $REPO_ROOT/local-rules.md, which git ignores. OpenCode follows it in every
# session. Keep it short and about code only: every request carries it, and a
# local model follows a short list better than a long one.
OPENCODE_RULES=

TZ=Europe/Amsterdam
