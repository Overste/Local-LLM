# Shared settings, identical on every machine. Per-machine settings go in
# local.env. After changing models or context sizes, rerun bin/up.sh on the
# server.

# Pinned versions.
OLLAMA_IMAGE_TAG=0.34.1
OPENCODE_VERSION=2.0.27

# Host port of the model endpoint. Always bound to 127.0.0.1.
OLLAMA_PORT=11434

# Role "agent": chat and tool use, for Zed's agent panel and OpenCode.
# Must make real tool calls, or Zed can only describe edits instead of doing
# them; bin/verify.sh checks this.
AGENT_BASE=qwen3.6:27b
AGENT_CTX=32768
# true if AGENT_BASE has a thinking mode; shows Zed's thinking toggle.
AGENT_THINKING=true

# Role "autocomplete": Zed edit predictions. Needs a "-base" (FIM) model.
# Kept small, so the agent keeps the VRAM for its context.
AUTOCOMPLETE_BASE=qwen2.5-coder:1.5b-base
AUTOCOMPLETE_CTX=4096

# More models to pull, space separated. They show up in Zed's model picker.
# Hugging Face GGUFs work too: hf.co/<user>/<repo>:<quant>
EXTRA_MODELS=""
