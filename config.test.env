# Overrides for testing the scripts on a machine without a GPU:
#   CONFIG_OVERRIDE=config.test.env bin/up.sh
# Uses its own project name and port, so it runs beside a real stack.

ROLE=server
USE_GPU=0
COMPOSE_PROJECT_NAME=local-llm-test
OLLAMA_PORT=11435

# Not the coder variant: at this size it writes tool calls as plain text.
AGENT_BASE=qwen2.5:1.5b
AGENT_CTX=4096
AUTOCOMPLETE_BASE=qwen2.5-coder:0.5b-base
AUTOCOMPLETE_CTX=2048
EXTRA_MODELS=""

PROJECTS_DIR=$REPO_ROOT/out/test-projects
OUT_DIR=$REPO_ROOT/out/test
