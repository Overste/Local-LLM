{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "agent": {
          "name": "agent (${AGENT_BASE})",
          "limit": {
            "context": ${AGENT_CTX},
            "output": 8192
          }
        }
      }
    }
  }
}
