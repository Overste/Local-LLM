// Merge these keys into ~/.config/zed/settings.json. Add the "OpenCode" entry
// to agent_servers next to any agents you already have there.
// "agent" and "autocomplete" are roles built on the server; which model sits
// behind each is set in config.env there.
{
  // OpenCode as an external agent in the agent panel, over ACP. It runs in its
  // container, so it only works in projects under PROJECTS_DIR.
  "agent_servers": {
    "OpenCode": {
      "type": "custom",
      "command": "${REPO_ROOT}/bin/opencode.sh",
      "args": ["opencode", "acp"]
    }
  },
  "agent": {
    "default_model": {
      "provider": "ollama",
      "model": "agent:latest",
      "enable_thinking": ${AGENT_THINKING}
    },
    // Every Zed task uses the agent role, so no second model takes VRAM next
    // to it. Short tasks skip the thinking step to answer sooner.
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "agent:latest",
      "enable_thinking": false
    },
    "commit_message_model": {
      "provider": "ollama",
      "model": "agent:latest",
      "enable_thinking": false
    },
    "thread_summary_model": {
      "provider": "ollama",
      "model": "agent:latest",
      "enable_thinking": false
    },
    "compaction_model": {
      "provider": "ollama",
      "model": "agent:latest",
      "enable_thinking": false
    },
    "subagent_model": {
      "provider": "ollama",
      "model": "agent:latest",
      "enable_thinking": ${AGENT_THINKING}
    }
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:${OLLAMA_PORT}",
      // Only the agent role is offered. The other models on the server are
      // the bases of the roles and the autocomplete model, which cannot chat.
      "auto_discover": false,
      "available_models": [
        {
          "name": "agent:latest",
          "display_name": "Agent (${AGENT_BASE})",
          "max_tokens": ${AGENT_CTX},
          "supports_tools": true,
          "supports_thinking": ${AGENT_THINKING}
        }
      ]
    }
  },
  "edit_predictions": {
    "provider": "ollama",
    "ollama": {
      "api_url": "http://localhost:${OLLAMA_PORT}",
      "model": "autocomplete",
      // Zed cannot infer the format from a role name. "qwen" matches the
      // default autocomplete base; change it if you change the base model.
      "prompt_format": "qwen",
      "max_output_tokens": 512
    }
  }
}
